{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "The Slums Launcher",
  "version": "1.0.2",
  "identifier": "com.theslums.launcher",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "The Slums Launcher",
        "width": 920,
        "height": 720,
        "resizable": true,
        "center": true,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENjEzNzY2RTJCMkFFRkMKUldUOHJyTGlaamRobmVyWGtBUC9LWjcxL0ZHYXh2TkpnQjMzeW05eWZoeG5RNUhSaE1GanJSUGoK",
      "endpoints": [
        "https://wowslums.asslorde.com/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}